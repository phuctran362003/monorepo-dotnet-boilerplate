@model IReadOnlyList<ProductViewModel>
@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<p>
    <a class="button" asp-action="Create">Create product</a>
</p>

@if (Model.Count == 0)
{
    <p>No products yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Status</th>
                <th>Created (UTC)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Status</td>
                <td>@product.CreatedAt.ToString("u")</td>
                <td><a asp-action="Details" asp-route-id="@product.Id">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
}
