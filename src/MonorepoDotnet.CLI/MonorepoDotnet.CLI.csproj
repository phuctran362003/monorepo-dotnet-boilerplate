<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>monorepo</AssemblyName>
    <RootNamespace>MonorepoDotnet.CLI</RootNamespace>

    <!-- Optional .NET global tool packaging (see docs/distribution.md). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>monorepo</ToolCommandName>
    <PackageId>monorepo-dotnet</PackageId>
    <Version>0.1.10</Version>
    <Authors>Trần Gia Phúc</Authors>
    <Copyright>Copyright (c) 2026 Trần Gia Phúc</Copyright>
    <Description>Interactive generator for ASP.NET Core solutions (DDD, Clean, 1-Layer, MVC) with PostgreSQL, EF Core and Docker.</Description>
    <PackageTags>dotnet;aspnetcore;ddd;cli;generator;postgresql;sqlserver</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/phuctran362003/monorepo-dotnet-boilerplate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/phuctran362003/monorepo-dotnet-boilerplate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Copy the published exe onto PATH as `monorepo`. Disable with -p:InstallAfterPublish=false. -->
    <InstallAfterPublish Condition="'$(InstallAfterPublish)' == ''">true</InstallAfterPublish>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonorepoDotnet.Core\MonorepoDotnet.Core.csproj" />
    <ProjectReference Include="..\MonorepoDotnet.Infrastructure\MonorepoDotnet.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <Target Name="InstallGlobalCommand" AfterTargets="Publish" Condition="'$(InstallAfterPublish)' == 'true' AND '$(RuntimeIdentifier)' != '' AND '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_PublishedExe>$([System.IO.Path]::GetFullPath('$(PublishDir)$(AssemblyName).exe'))</_PublishedExe>
      <_InstallScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\scripts\install-command.ps1'))</_InstallScript>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_InstallScript)&quot; -ExePath &quot;$(_PublishedExe)&quot;" />
  </Target>

</Project>
