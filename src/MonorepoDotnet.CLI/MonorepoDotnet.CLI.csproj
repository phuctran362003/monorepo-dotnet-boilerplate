<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>monorepo-dotnet</AssemblyName>
    <RootNamespace>MonorepoDotnet.CLI</RootNamespace>

    <!-- Optional .NET global tool packaging (see docs/distribution.md). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>monorepo-dotnet</ToolCommandName>
    <PackageId>MonorepoDotnet.CLI</PackageId>
    <Version>0.1.0</Version>
    <Description>Interactive generator for ASP.NET Core DDD solutions with PostgreSQL, EF Core and Docker.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonorepoDotnet.Core\MonorepoDotnet.Core.csproj" />
    <ProjectReference Include="..\MonorepoDotnet.Infrastructure\MonorepoDotnet.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
